#!/bin/bash
#PBS -N respiramfm-phase1
set -euo pipefail

: "${VENV:?Pass VENV=/absolute/path/to/.venv}"
: "${COMMAND:?Pass COMMAND for the confirmed Phase 1 invocation}"
: "${OUTPUT_DIR:?Pass OUTPUT_DIR}"
mkdir -p "$OUTPUT_DIR"
source "$VENV/bin/activate"
cd "$PBS_O_WORKDIR"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
eval "$COMMAND"
